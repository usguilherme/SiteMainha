+        // ===== NOVO: HORÁRIOS OCUPADOS =====
+        // Consulta o node público "disponibilidade" (sem dados sensíveis de clientes)
+        // sempre que a profissional ou a data mudarem, e mostra os horários já ocupados.
+        let horariosOcupadosCache = [];
+
+        function chaveHora(hora) {
+            return hora.replace(':', '-');
+        }
+
+        function carregarHorariosOcupados() {
+            const data = document.getElementById("pub-data").value;
+            const profId = document.getElementById("pub-profissional").value;
+            const divAviso = document.getElementById("pub-horarios-ocupados");
+            horariosOcupadosCache = [];
+
+            if(!data) {
+                divAviso.style.display = "none";
+                return;
+            }
+
+            if(!profId) {
+                // Sem profissional específica escolhida, não dá pra checar conflito com precisão
+                divAviso.style.display = "block";
+                divAviso.innerHTML = "ℹ️ Escolha uma profissional específica para vermos os horários já ocupados.";
+                return;
+            }
+
+            db.ref(`disponibilidade/${data}/${profId}`).once('value').then(snap => {
+                const ocupados = snap.val() ? Object.keys(snap.val()) : [];
+                horariosOcupadosCache = ocupados.map(h => h.replace('-', ':'));
+
+                if(horariosOcupadosCache.length === 0) {
+                    divAviso.style.display = "block";
+                    divAviso.innerHTML = "✅ Nenhum horário ocupado nesse dia com essa profissional ainda.";
+                } else {
+                    divAviso.style.display = "block";
+                    divAviso.innerHTML = "🕐 Horários já ocupados nesse dia: <strong>" + horariosOcupadosCache.sort().join(", ") + "</strong>";
+                }
+                verificarConflitoHorario();
+            }).catch(err => {
+                console.error("Erro ao checar horários ocupados:", err);
+                divAviso.style.display = "none";
+            });
+        }
+
+        function verificarConflitoHorario() {
+            const hora = document.getElementById("pub-hora").value;
+            const avisoConflito = document.getElementById("pub-aviso-conflito");
+            const temConflito = hora && horariosOcupadosCache.includes(hora);
+            avisoConflito.style.display = temConflito ? "block" : "none";
+            return temConflito;
+        }
+
+        document.getElementById("pub-data").addEventListener("change", carregarHorariosOcupados);
+        document.getElementById("pub-profissional").addEventListener("change", carregarHorariosOcupados);
+        document.getElementById("pub-hora").addEventListener("change", verificarConflitoHorario);
+        // ===== FIM NOVO =====
